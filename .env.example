# Copy to .env.local. Never commit real keys. Never use NEXT_PUBLIC_ for secrets.

# --- Supabase (Project Settings > API) ---
# If NEXT_PUBLIC_SUPABASE_URL is empty, lib/db falls back to in-memory sample data from content/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by API routes, ingest, report storage and admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# anthropic | openai | mock   (mock = canned answers, no key needed; used by tests and CI)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# google: Gemini chat + gemini-embedding-001 (1536 dims). One key runs the whole app.
GOOGLE_GENERATIVE_AI_API_KEY=
# Embeddings: EMBEDDING_PROVIDER=openai|google. Default: google when AI_PROVIDER=google, else openai.
# Changing it requires re-running `pnpm ingest` (vectors from different models are not comparable).
EMBEDDING_PROVIDER=
# Google free tier counts every embedded text as one request (100/min). Cap per server instance; default 90, min 50.
GOOGLE_EMBED_PER_MIN=
# Required for OpenAI embeddings (text-embedding-3-small) when EMBEDDING_PROVIDER=openai, except in mock mode.
OPENAI_API_KEY=
# Optional model overrides. Defaults are chosen in lib/ai/provider.ts.
AI_MODEL_CHAT=
AI_MODEL_FAST=
# google only: model tried once when the chat/fast model returns 429/503 before any output (default gemini-3.5-flash-lite).
AI_MODEL_FALLBACK=
# 1 = log one line per Google HTTP call (model, status, ms, retry-after). Never logs keys, headers or bodies.
AI_DEBUG=

# Legal Guide: minimum cosine similarity for a chunk to be used as a source (tune with evals).
# Blank = per-embedding-model default (openai 0.30, google 0.62). Set a number to override.
LEGAL_MIN_SIMILARITY=
# Optional: override the content/legal root (tests).
# LEGAL_CONTENT_DIR=
# Tests only: keep saved reports in memory instead of Supabase.
SAMPLE_REPORTS_IN_MEMORY=

# --- Admin page (/[locale]/admin and /api/admin/*), HTTP Basic auth, user "admin" ---
ADMIN_PASSWORD=

# --- Rate limit for /api/* (requests per minute per IP) ---
RATE_LIMIT_AI_PER_MIN=15
RATE_LIMIT_DATA_PER_MIN=60
